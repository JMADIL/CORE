# Configure at least one provider. OpenRouter takes precedence when both are set.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
GOOGLE_MODEL=gemini-2.5-flash

# Optional MCP servers (install their executables separately).
GOOGLE_MAPS_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_HOST=

# Optional account/credit check only; hosted ElevenCreative MCP requires OAuth.
ELEVENLABS_API_KEY=
# Vercel Connect UID returned when creating your ElevenCreative OAuth connector.
ELEVENLABS_CONNECTOR=
ELEVENLABS_SHARED_ACCOUNT=false
# Owner setup only: retain the random key locally; deploy only its SHA-256 hash.
ELEVENLABS_OWNER_SETUP_KEY=
ELEVENLABS_OWNER_SETUP_HASH=
# Rolling 24-hour generation-attempt limits for the shared public demo.
ELEVENLABS_DEMO_PER_VISITOR=5
ELEVENLABS_DEMO_GLOBAL=20
CORE_PUBLIC_URL=http://localhost:3000

# Session storage and limits; Docker Compose uses its own persistent data volume.
DATABASE_PATH=.data/sessions.sqlite3
# Vercel: use Neon's pooled PostgreSQL URL with sslmode=require.
# DATABASE_URL takes precedence over the local DATABASE_PATH.
DATABASE_URL=
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_TTL_SECONDS=604800
MAX_SESSIONS=1000
MAX_HISTORY_TURNS=20
MAX_HISTORY_BYTES=250000
REQUESTS_PER_MINUTE=30
GLOBAL_REQUESTS_PER_MINUTE=120
MAX_REQUEST_BYTES=65536
CHAT_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=30
DISCOVERY_TIMEOUT_SECONDS=15
MAX_TOOL_ROUNDS=4
MCP_CACHE_SECONDS=300

# Optional: trusted gateway / API-client secret. Do not expose it in browser code.
# When enabled, every chat/delete request must include X-API-Key via your gateway.
CHAT_API_KEY=
